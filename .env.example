# Agentes de IA a instalar en la imagen (separados por coma).
# Soportados: claude, codex, opencode
# Vacío = ninguno (el container funciona igual, sin agentes).
# Ejemplo: AGENTS=claude,codex,opencode
# Los scripts run*.sh/.bat lo setean con --agents.
AGENTS=

# Nombre de la instancia (proyecto Compose). Prefija el container y los
# volúmenes de persistencia (<nombre>_claude-config, etc.).
# Solo [a-z0-9_-], empezando con letra o dígito. Vacío = ai-sandbox.
# Los scripts run*.sh/.bat lo setean con --name.
SANDBOX_NAME=
